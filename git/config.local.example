# Machine-local Git configuration loaded by ~/.gitconfig.
# Keep device-specific signing keys and signer paths here.
#
# Example: 1Password SSH signing
#
# [user]
#     signingKey = ssh-ed25519 REPLACE_WITH_PUBLIC_SIGNING_KEY
#
# [commit]
#     gpgsign = true
#
# [gpg]
#     format = ssh
#
# [gpg "ssh"]
#     program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
#     allowedSignersFile = ~/.config/git/allowed_signers
