# Machine-local Git configuration loaded by ~/.gitconfig.
# Keep device-specific signing keys and signer paths here.
#
# Example: GPG commit signing
# The Proton Pass SSH key is for SSH transport/authentication only.
#
# [commit]
#     gpgsign = true
#
# [gpg]
#     format = openpgp
#
# [user]
#     signingKey = REPLACE_WITH_GPG_KEY_ID
