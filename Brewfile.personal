# ----------------------------------------
# Personal-machine Brewfile — applied on top of the shared Brewfile when
# ~/.config/dotfiles-local/profile contains "personal".
# Install with: brew bundle --file=~/dotfiles/Brewfile.personal
# ----------------------------------------

# Taps
tap "stalecontext/forgejo-cli-plus", "https://codeberg.org/stalecontext/homebrew-forgejo-cli-plus.git"

# Personal infra CLI
brew "httpie"
brew "mosh"
brew "coreutils"
brew "hcloud"
brew "forgejo-cli-plus"

# Productivity & communication
# Casks here are bootstrap-only installs of each vendor's own artifact
# (checked 2026-06: every cask URL is the official distribution point).
# The apps self-update through their own channels after install, so cask
# version lag doesn't apply (`brew upgrade` skips auto_updates casks).
# Exception: hiddenbar has no self-updater — brew upgrade is its update path.
cask "raycast"
cask "hiddenbar"
cask "google-chrome@dev"
cask "helium-browser"
cask "obsidian"
cask "spotify"
cask "stats"
cask "telegram"
cask "whatsapp"
