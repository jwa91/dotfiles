#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=shell/shim-policy.sh
source "${DOTFILES_DIR:-$HOME/dotfiles}/shell/shim-policy.sh"

if ! node_path="$(mise which node 2>/dev/null)" || ! npm_path="$(mise which npm 2>/dev/null)"; then
  echo "npm requires the mise-owned Node baseline; run: just toolchains" >&2
  exit 127
fi

if [[ "${1:-}" == "install" || "${1:-}" == "i" ]] && dotfiles_has_global_flag "$@"; then
  echo "x npm $1 -g is not the owner for this mutation." >&2
  echo "  Use a project dependency, npx for one-off execution, or the Brewfile." >&2
  exit 127
fi

exec env PATH="$(dirname "$node_path"):$PATH" "$npm_path" "$@"
