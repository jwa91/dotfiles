#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=shell/shim-info.sh
source "${DOTFILES_DIR:-$HOME/dotfiles}/shell/shim-info.sh"

if ! node_path="$(mise which node 2>/dev/null)" || ! npm_path="$(mise which npm 2>/dev/null)"; then
  echo "npm requires a project-owned Node runtime in mise config" >&2
  exit 127
fi

has_global_flag() {
  local arg previous=""

  for arg in "$@"; do
    case "$arg" in
      -g|--global|--location=global)
        return 0
        ;;
    esac

    if [[ "$previous" == "--location" && "$arg" == "global" ]]; then
      return 0
    fi

    previous="$arg"
  done

  return 1
}

if [[ "${1:-}" == "install" || "${1:-}" == "i" ]] && has_global_flag "$@"; then
  echo "x npm $1 -g is not the owner for this mutation." >&2
  echo "  Use project dependencies, mise's npm: backend, or the Brewfile." >&2
  exit 127
fi

dotfiles_infomsg NPM "npm uses project-owned Node tooling; global npm installs are intentionally unavailable. resolved via mise: $npm_path; node: $node_path. Hide this notice with DISABLE_DOTFILES_INFOMSG_NPM=1."

exec env PATH="$(dirname "$node_path"):$PATH" "$npm_path" "$@"
