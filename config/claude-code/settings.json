{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(mise use -g:*)",
      "Bash(mise use --global:*)",
      "Bash(npm install -g:*)",
      "Bash(npm install --global:*)",
      "Bash(npm install --location global:*)",
      "Bash(npm install --location=global:*)",
      "Bash(npm i -g:*)",
      "Bash(npm i --global:*)",
      "Bash(npm i --location global:*)",
      "Bash(npm i --location=global:*)",
      "Bash(pnpm add -g:*)",
      "Bash(pnpm add --global:*)",
      "Bash(pnpm install -g:*)",
      "Bash(pnpm install --global:*)",
      "Bash(yarn global:*)",
      "Bash(yarn global add:*)",
      "Bash(bun add -g:*)",
      "Bash(bun add --global:*)",
      "Bash(bun install -g:*)",
      "Bash(bun install --global:*)",
      "Bash(bun upgrade:*)",
      "Bash(cargo install:*)",
      "Bash(go env -w:*)",
      "Bash(go install:*)",
      "Bash(rustup update:*)",
      "Bash(rustup default:*)",
      "Bash(rustup override:*)",
      "Bash(rustup toolchain install:*)",
      "Bash(rustup toolchain uninstall:*)",
      "Bash(rustup target add:*)",
      "Bash(rustup target remove:*)",
      "Bash(rustup component add:*)",
      "Bash(rustup component remove:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(uv tool install:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "skipWorkflowUsageWarning": true
}
