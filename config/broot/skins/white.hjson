# Light (Gruvbox Light) skin for broot, used when the terminal background is light.
# Format per entry: "<foreground> <background> <attributes>"
skin: {
    default: "rgb(60,56,54) none"
    tree: "rgb(168,153,132) none"
    parent: "rgb(80,73,69) none"
    file: "rgb(60,56,54) none"
    directory: "rgb(7,102,120) none bold"
    exe: "rgb(121,116,14) none"
    link: "rgb(66,123,88) none"
    pruning: "rgb(168,153,132) none italic"
    perm__: "rgb(189,174,147) none"
    perm_r: "rgb(181,118,20) none"
    perm_w: "rgb(157,0,6) none"
    perm_x: "rgb(121,116,14) none"
    owner: "rgb(124,111,100) none"
    group: "rgb(168,153,132) none"
    count: "rgb(124,111,100) rgb(235,219,178)"
    dates: "rgb(124,111,100) none"
    sparse: "rgb(181,118,20) none"
    content_extract: "rgb(66,123,88) none italic"
    content_match: "rgb(181,118,20) none bold"
    git_branch: "rgb(60,56,54) none"
    git_insertions: "rgb(121,116,14) none"
    git_deletions: "rgb(157,0,6) none"
    git_status_current: "rgb(235,219,178) none"
    git_status_modified: "rgb(181,118,20) none"
    git_status_new: "rgb(121,116,14) none bold"
    git_status_ignored: "rgb(168,153,132) none"
    git_status_conflicted: "rgb(157,0,6) none"
    git_status_other: "rgb(157,0,6) none"
    selected_line: "none rgb(235,219,178)"
    char_match: "rgb(121,116,14) none"
    file_error: "rgb(157,0,6) none"
    flag_label: "rgb(124,111,100) none"
    flag_value: "rgb(181,118,20) none bold"
    input: "rgb(60,56,54) none"
    status_error: "rgb(157,0,6) rgb(235,219,178)"
    status_job: "rgb(181,118,20) rgb(235,219,178)"
    status_normal: "rgb(60,56,54) rgb(235,219,178)"
    status_italic: "rgb(181,118,20) rgb(235,219,178)"
    status_bold: "rgb(181,118,20) rgb(235,219,178) bold"
    status_code: "rgb(60,56,54) rgb(235,219,178)"
    status_ellipsis: "rgb(60,56,54) rgb(235,219,178)"
    purpose_normal: "rgb(60,56,54) rgb(235,219,178)"
    purpose_italic: "rgb(181,118,20) rgb(235,219,178)"
    purpose_bold: "rgb(181,118,20) rgb(235,219,178) bold"
    purpose_ellipsis: "rgb(60,56,54) rgb(235,219,178)"
    scrollbar_track: "rgb(235,219,178) none"
    scrollbar_thumb: "rgb(168,153,132) none"
    help_paragraph: "rgb(60,56,54) none"
    help_bold: "rgb(181,118,20) none bold"
    help_italic: "rgb(66,123,88) none italic"
    help_code: "rgb(60,56,54) rgb(235,219,178)"
    help_headers: "rgb(175,58,3) none bold"
    help_table_border: "rgb(189,174,147) none"
    preview_title: "rgb(60,56,54) rgb(235,219,178)"
    preview: "rgb(60,56,54) rgb(251,241,199)"
