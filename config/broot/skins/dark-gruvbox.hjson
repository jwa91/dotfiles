# Gruvbox Dark (Hard) skin for broot
# Palette: https://github.com/morhetz/gruvbox
# Format per entry: "<foreground> <background> <attributes>"
# Colors: rgb(r,g,b) | ansi(n) | gray(n) | none ; attrs: bold italic underlined
skin: {
    default: "rgb(235,219,178) none"
    tree: "rgb(124,111,100) none"
    parent: "rgb(213,196,161) none"
    file: "rgb(235,219,178) none"
    directory: "rgb(131,165,152) none bold"
    exe: "rgb(184,187,38) none"
    link: "rgb(142,192,124) none"
    pruning: "rgb(124,111,100) none italic"
    perm__: "rgb(102,92,84) none"
    perm_r: "rgb(250,189,47) none"
    perm_w: "rgb(251,73,52) none"
    perm_x: "rgb(184,187,38) none"
    owner: "rgb(168,153,132) none"
    group: "rgb(124,111,100) none"
    count: "rgb(168,153,132) rgb(60,56,54)"
    dates: "rgb(168,153,132) none"
    sparse: "rgb(250,189,47) none"
    content_extract: "rgb(142,192,124) none italic"
    content_match: "rgb(250,189,47) none bold"
    git_branch: "rgb(235,219,178) none"
    git_insertions: "rgb(184,187,38) none"
    git_deletions: "rgb(251,73,52) none"
    git_status_current: "rgb(60,56,54) none"
    git_status_modified: "rgb(250,189,47) none"
    git_status_new: "rgb(184,187,38) none bold"
    git_status_ignored: "rgb(124,111,100) none"
    git_status_conflicted: "rgb(251,73,52) none"
    git_status_other: "rgb(251,73,52) none"
    selected_line: "none rgb(40,40,40)"
    char_match: "rgb(184,187,38) none"
    file_error: "rgb(251,73,52) none"
    flag_label: "rgb(168,153,132) none"
    flag_value: "rgb(250,189,47) none bold"
    input: "rgb(235,219,178) none"
    status_error: "rgb(251,73,52) rgb(60,56,54)"
    status_job: "rgb(250,189,47) rgb(40,40,40)"
    status_normal: "rgb(235,219,178) rgb(40,40,40)"
    status_italic: "rgb(250,189,47) rgb(40,40,40)"
    status_bold: "rgb(250,189,47) rgb(40,40,40) bold"
    status_code: "rgb(235,219,178) rgb(40,40,40)"
    status_ellipsis: "rgb(235,219,178) rgb(40,40,40)"
    purpose_normal: "rgb(235,219,178) rgb(40,40,40)"
    purpose_italic: "rgb(250,189,47) rgb(40,40,40)"
    purpose_bold: "rgb(250,189,47) rgb(40,40,40) bold"
    purpose_ellipsis: "rgb(235,219,178) rgb(40,40,40)"
    scrollbar_track: "rgb(60,56,54) none"
    scrollbar_thumb: "rgb(124,111,100) none"
    help_paragraph: "rgb(235,219,178) none"
    help_bold: "rgb(250,189,47) none bold"
    help_italic: "rgb(142,192,124) none italic"
    help_code: "rgb(235,219,178) rgb(60,56,54)"
    help_headers: "rgb(254,128,25) none bold"
    help_table_border: "rgb(102,92,84) none"
    preview_title: "rgb(235,219,178) rgb(40,40,40)"
