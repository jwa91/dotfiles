---
syntax: bash
tags: [ zsh, aliases, functions, dotfiles, personal ]
---
# Shell
reload                    # Re-source ~/.zshrc
reloadenv                 # Re-source ~/.zshenv

# Edit (e + target) — opens in terminal-aware editor
ezsh                      # Open zsh dotfiles dir
edots                     # Open dotfiles dir
evault                    # Open vault
edev                      # Open developer dir

# Navigate (cd + target)
cdzsh                     # cd to zsh dotfiles dir
cddots                    # cd to dotfiles dir
cdvault                   # cd to vault
cdd [subdir]              # cd to DEV_DIR (or subdir within it)

# Navigation
z <query>                 # Jump to frecency-matched directory (zoxide)
zi                        # Interactive directory picker (zoxide + fzf)
ls                        # ls -FaG (colorized, all, classify)
...                       # cd ../..
....                      # cd ../../..
.....                     # cd ../../../..

# Tmux (t + action)
tmain                     # Attach or create 'main' tmux session
tls                       # List tmux sessions
tpick [--mobile]          # Interactive tmux session picker (fzf)

# Make (mk + thing)
mkpass                    # Generate random password -> clipboard
mkroute <path>            # Create Next.js App Router route structure
mkskill [name]            # Install agent skill (or list available)

# Python
pyclean                   # Remove __pycache__ dirs recursively

# Utilities
key NAME [NAME ...]       # Load API keys from 1Password
rwe                       # Retry last command with escaped arguments
zshdoctor                 # Validate zsh config, deps, and paths
