# Bootstrap
just bootstrap             # Full new-machine convergence
just init                  # Initialize managed machine capabilities
just set                   # Converge repository-controlled configuration
just doctor                # Check managed links, tools, runtime ownership
just links                 # Recreate managed symlinks
just dry-run               # Preview bootstrap actions

# Help system
how zsh                    # Personal cheat sheet first, then tldr, then man
cheat -l                   # List available personal/community sheets
cheat -e dotfiles          # Edit a personal sheet in this repo
just help                  # Update community cheat sheets and tldr cache
tldr --update              # Refresh tldr examples only

# Ownership model
just brew-sync             # Install missing Brewfile entries, do not upgrade
just brew-vulns            # Check Brewfile formulae for known vulnerabilities
just brew-outdated         # Show Homebrew-owned updates; hide self-updating apps
just brew-upgrade          # Upgrade Homebrew-owned tools/casks only
just toolchains            # Install repo-declared mise toolchains
brewsync                   # Shell alias for the same Homebrew presence check
brewoutdated               # Safe update report from any directory
brewup                     # Safe upgrade from any directory
