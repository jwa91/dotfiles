syntax: bash
tags: [ tmux, terminal, multiplexer, sessions, personal ]
---
# Sessions
tmux new -s name          # New named session
tmux attach -t name       # Attach to session
tmux switch -t name       # Switch to session (from inside tmux)
tmux kill-session -t name # Kill session
tmux ls                   # List sessions

# Prefix key: Ctrl-Space (then press the command key)

# Windows (tabs)
c                         # New window
n / p                     # Next / previous window
0-9                       # Jump to window by number
,                         # Rename window
&                         # Kill window
w                         # Window picker

# Panes (splits)
%                         # Split vertical
"                         # Split horizontal
o                         # Cycle panes
x                         # Kill pane
z                         # Toggle pane zoom (fullscreen)
arrows                    # Navigate panes
space                     # Cycle pane layouts
{  /  }                   # Swap pane left / right

# Copy mode (vi-style if set)
[                         # Enter copy mode
q                         # Exit copy mode
/                         # Search forward
?                         # Search backward
space                     # Start selection
enter                     # Copy selection

# Resize panes (prefix + hold arrow, or:)
# prefix + Alt-arrows     Resize in 5-cell steps

# Command mode
:                         # Open command prompt
:resize-pane -D 10       # Resize pane down 10 rows
:swap-window -t 0        # Move window to position 0
:setw synchronize-panes  # Toggle sync input to all panes

# Useful commands
tmux list-keys            # Show all keybindings
tmux show -g              # Show global options
tmux source ~/.tmux.conf  # Reload config
